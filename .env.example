# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# SerpApi Google Hotels (paid per search; free trial = 100 searches)
SERPAPI_API_KEY=

# Optional overrides (defaults shown)
# PARTY_ADULTS=2
# PARTY_CHILDREN_AGES=[15,7]
# MAX_TRAVEL_HOURS=7.0
# SEARCH_WEEKENDS=4
# INCLUDE_LONG_WEEKENDS=true
# BUDGET_TOTAL_EUR=800
# MAX_SEARCHES_PER_RUN=20
# CACHE_TTL_HOURS=12

# --- Continuous mode: python -m src.cli --daemon ----------------------------
# Each run spends up to MAX_SEARCHES_PER_RUN SerpApi searches, rotating through
# all (destination, weekend) pairs across runs. 12h x 20 searches = ~1200/month.
# POLL_INTERVAL_HOURS=12
# POLL_JITTER_MINUTES=15
# DB_PATH=data/deals.db

# Alerts: deals scoring >= ALERT_MIN_SCORE (0-100); a deal already alerted is
# alerted again only when it gets at least ALERT_MIN_PRICE_DROP_EUR cheaper.
# ALERT_MIN_SCORE=60
# ALERT_MIN_PRICE_DROP_EUR=30
# ALERT_MAX_PER_MESSAGE=10

# Terme resorts (data/terme_resorts.yaml) are searched by name besides their town:
# one extra SerpApi search per resort and weekend.
# INCLUDE_RESORT_TARGETS=true

# Terme offer pages (data/terme_offer_pages.yaml): alert on new package titles.
# Free (no API), each page fetched at most every OFFERS_FETCH_INTERVAL_HOURS.
# TERME_OFFERS_ENABLED=true
# OFFERS_FETCH_INTERVAL_HOURS=12

# Optional live train/bus check before alerting (Google Routes API, transit mode;
# enable "Routes API" in Google Cloud and restrict the key to it). Deals whose
# fastest journey leaving after FRIDAY_DEPARTURE_TIME on the check-in day is over
# MAX_TRAVEL_HOURS_SOFT are not alerted. Leave empty to rely on the static catalogue.
GOOGLE_MAPS_API_KEY=
# MAX_TRAVEL_HOURS_SOFT=8.0
# FRIDAY_DEPARTURE_TIME=14:00
# TRANSIT_CACHE_DAYS=30

# Telegram: create a bot with @BotFather, send it a message, then read your
# chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (Gmail: smtp.gmail.com, port 587, and an App Password, not your password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# ALERT_EMAIL_FROM=
# Comma-separated
ALERT_EMAIL_TO=
